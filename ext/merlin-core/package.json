{
  "name": "merlin-core",
  "displayName": "Merlin Core",
  "publisher": "merlin",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "browser": "./extension.js",
  "activationEvents": [
    "onFileSystem:merlin",
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "merlin.run",
        "title": "Merlin: Run File",
        "icon": "$(play)"
      },
      {
        "command": "merlin.stop",
        "title": "Merlin: Stop Running Command",
        "icon": "$(debug-stop)"
      },
      {
        "command": "merlin.installC",
        "title": "Merlin: Install C/C++ Pack",
        "icon": "$(cloud-download)"
      },
      {
        "command": "merlin.removeC",
        "title": "Merlin: Remove C/C++ Pack",
        "icon": "$(trash)"
      },
      {
        "command": "merlin.installPython",
        "title": "Merlin: Install Python (native) Pack",
        "icon": "$(cloud-download)"
      },
      {
        "command": "merlin.removePython",
        "title": "Merlin: Remove Python (native) Pack",
        "icon": "$(trash)"
      },
      {
        "command": "merlin.refreshPacks",
        "title": "Merlin: Refresh Packs",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "merlin.run",
          "group": "navigation@1",
          "when": "resourceScheme == merlin"
        }
      ],
      "view/item/context": [
        {
          "command": "merlin.installC",
          "when": "view == merlin.packs && viewItem == c-missing",
          "group": "inline"
        },
        {
          "command": "merlin.removeC",
          "when": "view == merlin.packs && viewItem == c-installed",
          "group": "inline"
        },
        {
          "command": "merlin.installPython",
          "when": "view == merlin.packs && viewItem == pynative-missing",
          "group": "inline"
        },
        {
          "command": "merlin.removePython",
          "when": "view == merlin.packs && viewItem == pynative-installed",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "merlin.refreshPacks",
          "when": "view == merlin.packs",
          "group": "navigation"
        }
      ]
    },
    "terminal": {
      "profiles": [
        {
          "id": "merlin.shell",
          "title": "Merlin Shell"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "merlinPacks",
          "title": "Merlin Packs",
          "icon": "$(cloud-download)"
        }
      ]
    },
    "views": {
      "merlinPacks": [
        {
          "id": "merlin.packs",
          "name": "Packs",
          "type": "tree"
        }
      ]
    }
  }
}