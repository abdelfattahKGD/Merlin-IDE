<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="#1f1f1f">
    <WebView android:id="@+id/webview" android:layout_width="match_parent" android:layout_height="match_parent"/>
    <LinearLayout android:id="@+id/splash" android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#1f1f1f" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="120dp" android:layout_height="120dp" android:src="@drawable/merlin_logo"/>
        <TextView android:id="@+id/splash_text" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Merlin" android:textColor="#cccccc" android:textSize="16sp"/>
    </LinearLayout>
</FrameLayout>
